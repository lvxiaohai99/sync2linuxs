# 同步排除规则（类似 .gitignore）
#
# 语法：
#   - 每行一个规则
#   - # 开头的是注释
#   - 支持通配符：* 匹配任意字符，** 匹配任意目录层级
#   - 以 / 结尾表示只匹配目录
#   - ! 开头表示不排除（白名单，但 rclone 不支持，需手动处理）
#
# 示例：
#   build/          - 排除所有 build 目录
#   **/build/       - 排除任意深度的 build 目录
#   *.o             - 排除所有 .o 文件
#   temp*.log       - 排除 temp 开头 .log 结尾的文件

# ============ 编译产物 ============
# C/C++ 编译产物
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app

# CMake 构建目录和产物（含 build-debug 等带后缀目录）
build/
Build/
BUILD/
build-*/
Build-*/
BUILD-*/
cmake-build-*/
**/build/
**/Build/
**/BUILD/
**/build-*/
**/Build-*/
**/BUILD-*/
# CMake 编译数据库（编译产物）
compile_commands.json
**/compile_commands.json

# Make 中间文件
*.d
*.dep

# ============ 安装目录（含 install-debug 等带后缀目录） ============
install/
Install/
INSTALL/
install-*/
Install-*/
INSTALL-*/
**/install/
**/Install/
**/INSTALL/
**/install-*/
**/Install-*/
**/INSTALL-*/

# ============ IDE 和编辑器 ============
# VS Code
.vscode/
*.code-workspace

# clangd：一端可能是文件、一端是目录，同步会致命失败；索引/.partial 也不该同步
# rclone 要同时排除「目录本身」和「目录内所有内容」
.clangd
.clangd/
.clangd/**
.clangd.*
**/.clangd
**/.clangd/
**/.clangd/**
**/.clangd.*
*.partial
**/*.partial
# clangd/语言服务本地缓存
.cache/
**/.cache/

# Visual Studio
.vs/
*.suo
*.user
*.sln.docstates
*.vcxproj.user

# CLion / JetBrains
.idea/
cmake-build-*/

# Eclipse
.project
.cproject
.settings/

# Vim
*.swp
*.swo
*~
.*.sw?

# ============ 版本控制 ============
# Git（嵌套仓库也要排除；只写 .git/ 时 rclone 可能漏掉子目录里的 .git）
.git/
.git/**
**/.git/
**/.git/**
*.orig

# SVN
.svn/
**/.svn/

# ============ 临时文件 ============
tmp/
temp/
*.tmp
*.temp
*.log
*.cache
.DS_Store
Thumbs.db

# ============ 语言特定 ============
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
*.egg-info/
dist/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log*

# Rust
target/
# 如果是库项目，可删除下一行以同步 Cargo.lock
Cargo.lock

# Go
vendor/

# Java
*.class
target/
*.jar
*.war

# ============ 特定问题目录 ============
# 已知有符号链接循环的工具链目录
jgzd_git/utils/rk3576-cross-toolchain/

# --- 原则：只同步「源码/文档/配置」；不扫 SDK整仓、编译输出、预编译工具链、第三方解压包 ---

# iot_vst：目录里几乎只有 forrepo（完整板级 SDK）
# forrepo 内含 buildroot/kernel/u-boot/chromium/output/prebuilts… 文件可达数百万
# 这类仓应用 git clone / 单独拷贝，不要走日常 bisync
jgzd_git/iot_vst/
**/iot_vst/forrepo/
**/buildroot/
**/prebuilts/
**/output/

# mt 第三方测量包（deb/解压产物，体积大且非源码）
jgzd_git/mt/_thirdparty_measure/
**/_thirdparty_measure/

# 本机 AI/编辑器工作区状态（各端各自生成）
.cursor/
**/.cursor/
.qoder/
**/.qoder/

# ============ 其他大文件/二进制 ============
# 大型数据文件（根据需要调整）
*.bin
*.dat
*.dump
*.iso
*.img

# 压缩包（如果不需要同步）
# *.zip
# *.tar
# *.tar.gz
# *.rar

# ============ 自定义规则 ============
# 若 obu/libafl 也不需要同步、且体积很大，取消下一行注释：
# obu/libafl/
# 在此添加你的自定义排除规则
